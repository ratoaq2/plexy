{
  "permissions": {
    "allow": [
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run mypy *)",
      "Bash(uv run python scripts/check_knowledge.py *)",
      "Bash(bash scripts/test.sh)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh pr view *)",
      "Bash(gh label list *)",
      "PowerShell(uv run pytest *)",
      "PowerShell(uv run ruff *)",
      "PowerShell(uv run mypy *)",
      "PowerShell(uv run python scripts/check_knowledge.py *)",
      "PowerShell(bash scripts/test.sh)",
      "PowerShell(git status *)",
      "PowerShell(git log *)",
      "PowerShell(git diff *)",
      "PowerShell(gh issue view *)",
      "PowerShell(gh issue list *)",
      "PowerShell(gh pr view *)",
      "PowerShell(gh label list *)"
    ],
    "deny": [
      "Read(./plexy*.yml)",
      "Read(./plexy*.yaml)",
      "Read(./plexy*.json)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(cat *plexy*.yml*)",
      "Bash(cat *plexy*.yaml*)",
      "Bash(cat *plexy*.json*)",
      "Bash(cat *.env*)",
      "Bash(cat *.env.**)",
      "Bash(type *plexy*.yml*)",
      "Bash(type *plexy*.yaml*)",
      "Bash(type *plexy*.json*)",
      "Bash(type *.env*)",
      "Bash(type *.env.**)",
      "Bash(more *plexy*.yml*)",
      "Bash(more *plexy*.yaml*)",
      "Bash(more *plexy*.json*)",
      "Bash(more *.env*)",
      "Bash(more *.env.**)",
      "Bash(less *plexy*.yml*)",
      "Bash(less *plexy*.yaml*)",
      "Bash(less *plexy*.json*)",
      "Bash(less *.env*)",
      "Bash(less *.env.**)",
      "Bash(head *plexy*.yml*)",
      "Bash(head *plexy*.yaml*)",
      "Bash(head *plexy*.json*)",
      "Bash(head *.env*)",
      "Bash(head *.env.**)",
      "Bash(tail *plexy*.yml*)",
      "Bash(tail *plexy*.yaml*)",
      "Bash(tail *plexy*.json*)",
      "Bash(tail *.env*)",
      "Bash(tail *.env.**)",
      "PowerShell(cat *plexy*.yml*)",
      "PowerShell(cat *plexy*.yaml*)",
      "PowerShell(cat *plexy*.json*)",
      "PowerShell(cat *.env*)",
      "PowerShell(cat *.env.**)",
      "PowerShell(type *plexy*.yml*)",
      "PowerShell(type *plexy*.yaml*)",
      "PowerShell(type *plexy*.json*)",
      "PowerShell(type *.env*)",
      "PowerShell(type *.env.**)",
      "PowerShell(Get-Content *plexy*.yml*)",
      "PowerShell(Get-Content *plexy*.yaml*)",
      "PowerShell(Get-Content *plexy*.json*)",
      "PowerShell(Get-Content *.env*)",
      "PowerShell(Get-Content *.env.**)",
      "PowerShell(gc *plexy*.yml*)",
      "PowerShell(gc *plexy*.yaml*)",
      "PowerShell(gc *plexy*.json*)",
      "PowerShell(gc *.env*)",
      "PowerShell(gc *.env.**)",
      "PowerShell(more *plexy*.yml*)",
      "PowerShell(more *plexy*.yaml*)",
      "PowerShell(more *plexy*.json*)",
      "PowerShell(more *.env*)",
      "PowerShell(more *.env.**)",
      "Bash(printenv*)",
      "Bash(env)",
      "PowerShell(Get-ChildItem env:*)",
      "PowerShell(gci env:*)",
      "PowerShell(dir env:*)",
      "PowerShell(ls env:*)"
    ]
  },
  "skillOverrides": {
    "dataviz": "user-invocable-only",
    "claude-api": "user-invocable-only",
    "schedule": "user-invocable-only"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project python \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_start.py\" 2>/dev/null || true",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
